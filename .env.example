# MarketLens AI - Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://marketlens:marketlens123@localhost:5432/marketlens_db
DATABASE_URL_SYNC=postgresql+psycopg2://marketlens:marketlens123@localhost:5432/marketlens_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys (optional)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
